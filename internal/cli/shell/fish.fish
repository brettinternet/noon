# Generated by noon shell init. Source manually; no startup files are modified.
set -g _noon_saved_status $status
function _noon_install
    set -l saved $argv[1]
    function _noon_complete
        # Tokenize the entire buffer without executing substitutions. Reading
        # to NUL/EOF keeps embedded newlines inside quoted path arguments.
        set -l words
        printf '%s' (commandline -pc | string collect) | read --null --tokenize --array words
        set -l current (commandline -ct | string collect)
        if test -n "$current"
            set -e words[-1]
        end
        set -l path_mode
        set -l candidates
        for line in (command noon $words[2..-1] "$current" --generate-shell-completion 2>/dev/null)
            switch $line
                case __NOON_COMPLETE_PATH_FILE__
                    set path_mode file
                case __NOON_COMPLETE_PATH_DIR__
                    set path_mode dir
                case '*'
                    set -a candidates "$line"
            end
        end
        if test -n "$path_mode"
            if string match -rq '^-+[^=]+=.*' -- "$current"
                set current (string replace -r -- '^[^=]*=' '' "$current")
            end
            if test "$path_mode" = dir
                __fish_complete_directories "$current"
            else
                __fish_complete_path "$current"
            end
            printf '%s\n' $candidates
            return
        end
        printf '%s\n' $candidates
    end
    complete -c noon -e
    complete -c noon -f -a '(_noon_complete)'
    functions -e _noon_chpwd
    set -g _noon_job '@JOB@'
    if test -n "$_noon_job"
        set -g _noon_directory "$PWD"
        set -g _noon_project (command noon shell entry --record -- fish "$_noon_job" '' "$PWD" "$PWD")
        function _noon_chpwd --on-variable PWD
            set -l saved $status
            set -g _noon_project (command noon shell entry -- fish "$_noon_job" "$_noon_project" "$_noon_directory" "$PWD")
            set -g _noon_directory "$PWD"
            return $saved
        end
    end
    return $saved
end
_noon_install $_noon_saved_status
